# MySQL example (encode special chars in password: @ → %40, ! → %21)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# JWT signing secret (long random string)
JWT_SECRET="replace-with-long-random-hex"
SESSION_SECRET="replace-with-long-random-hex"

# API
API_PORT=4001
API_ORIGIN=http://localhost:4001

# CORS — CMS UI origin (credentials) + optional marketing site
CMS_ORIGIN=http://localhost:3030
CORS_ORIGIN=http://localhost:5173

# Bootstrap admin (used only by seed)
SEED_ADMIN_EMAIL=admin@ruxin.local
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Admin
